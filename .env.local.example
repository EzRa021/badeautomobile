# -----------------------------------------------------------------------------
# Bade Automobile — environment variables
# Copy to `.env.local` and fill in from your Supabase project
# (Project Settings -> API). Never commit `.env.local`.
# -----------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server only — used by trusted server code (never exposed to the browser).
# Required for the in-app Staff page (creating/removing staff accounts).
# Supabase -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
